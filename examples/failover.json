    {
      "id": "backup",
      "name": "Backup (OpenRouter)",
      "type": "openai_compatible",
      "base_url": "https://openrouter.ai/api",
      "api_key_env": "OPENROUTER_API_KEY",
      "enabled": true,
      "models": [
        {"id": "gpt-4o-mini", "model": "openai/gpt-4o-mini", "enabled": true, "priority": 1, "capabilities": {"streaming": true, "tools": true}}
      ]
    }
  ]
