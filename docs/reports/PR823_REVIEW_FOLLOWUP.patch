-// TestAdminRequestBodyReadsAreBounded is a static contract on the handler
-// package: every read of an inbound request body must be bounded. An unbounded
-// read lets a client decide how much memory a handler allocates, and this
-// package already bounds ~15 call sites at 4 KiB–1 MiB — a single unbounded
-// outlier is invisible in review, which is exactly how one regressed (the
-// autopilot action handler decoded r.Body with no limit).
-//
-// Two bounded forms are accepted:
-//
-//  1. an inline bound on the same line — http.MaxBytesReader(w, r.Body, n) or
-//     io.LimitReader(r.Body, n);
-//  2. a bound assigned to r.Body shortly before the read, as
-//     admin_nexaflow_task8.go does (r.Body = http.MaxBytesReader(...)).
-//
-// Any other read of r.Body that decodes or copies it fails the test.
+// bodyReadFindings checks direct json.NewDecoder and io.ReadAll uses of
+// r.Body. It accepts a bound wrapped around that body, or an unconditional
+// top-level body assignment earlier in the same function with no intervening
+// reassignment. This is deliberately conservative, not general taint analysis:
+// aliases, other APIs and interprocedural flows still require review.
+func bodyReadFindings(name string, src []byte) (int, []string, error) {
+	fset := token.NewFileSet()
+	f, err := parser.ParseFile(fset, name, src, 0)
+	if err != nil {
+		return 0, nil, err
+	}
+	isBody := func(e ast.Expr) bool {
+		s, ok := e.(*ast.SelectorExpr)
+		if !ok || s.Sel.Name != "Body" {
+			return false
+		}
+		id, ok := s.X.(*ast.Ident)
+		return ok && id.Name == "r"
+	}
+	isBound := func(e ast.Expr) bool {
+		c, ok := e.(*ast.CallExpr)
+		if !ok {
+			return false
+		}
+		s, ok := c.Fun.(*ast.SelectorExpr)
+		if !ok {
+			return false
+		}
+		id, ok := s.X.(*ast.Ident)
+		if !ok {
+			return false
+		}
+		return (id.Name == "http" && s.Sel.Name == "MaxBytesReader" && len(c.Args) == 3 && isBody(c.Args[1])) ||
+			(id.Name == "io" && s.Sel.Name == "LimitReader" && len(c.Args) == 2 && isBody(c.Args[0]))
+	}
+	checked := 0
+	var findings []string
+	for _, decl := range f.Decls {
+		fn, ok := decl.(*ast.FuncDecl)
+		if !ok || fn.Body == nil {
+			continue
+		}
+		// Only an assignment that is a direct statement of the function body
+		// is definitely reached on every path to a later top-level statement.
+		var topBounds []token.Pos
+		for _, stmt := range fn.Body.List {
+			a, ok := stmt.(*ast.AssignStmt)
+			if !ok || len(a.Lhs) != 1 || len(a.Rhs) != 1 {
+				continue
+			}
+			if isBody(a.Lhs[0]) && isBound(a.Rhs[0]) {
+				topBounds = append(topBounds, a.End())
+			}
+		}
+		var writes []token.Pos
+		ast.Inspect(fn.Body, func(n ast.Node) bool {
+			a, ok := n.(*ast.AssignStmt)
+			if ok {
+				for _, e := range a.Lhs {
+					if isBody(e) {
+						writes = append(writes, a.Pos())
+					}
+				}
+			}
+			return true
+		})
+		ast.Inspect(fn.Body, func(n ast.Node) bool {
+			c, ok := n.(*ast.CallExpr)
+			if !ok || len(c.Args) == 0 {
+				return true
+			}
+			s, ok := c.Fun.(*ast.SelectorExpr)
+			if !ok {
+				return true
+			}
+			id, ok := s.X.(*ast.Ident)
+			if !ok || !((id.Name == "json" && s.Sel.Name == "NewDecoder") || (id.Name == "io" && s.Sel.Name == "ReadAll")) {
+				return true
+			}
+			arg := c.Args[0]
+			if isBound(arg) {
+				checked++
+				return true
+			}
+			if !isBody(arg) {
+				return true
+			}
+			checked++
+			bound := token.NoPos
+			for _, p := range topBounds {
+				if p < c.Pos() && p > bound {
+					bound = p
+				}
+			}
+			for _, p := range writes {
+				if p > bound && p < c.Pos() {
+					bound = token.NoPos
+				}
+			}
+			if bound == token.NoPos {
+				findings = append(findings, fmt.Sprintf("%s: unbounded r.Body read", fset.Position(c.Pos())))
+			}
+			return true
+		})
+	}
+	return checked, findings, nil
+}
